generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName  String
  lastName   String
  email      String   @unique
  department String
  role       UserRole @default(STAFF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  groups           GroupMember[]
  assignedTickets  Ticket[]      @relation("TicketAssignee")
}

model TicketGroup {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]
  tickets Ticket[]
}

model GroupMember {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @db.ObjectId
  groupId String @db.ObjectId

  user  User        @relation(fields: [userId], references: [id])
  group TicketGroup @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Ticket {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  groupId            String       @db.ObjectId
  assigneeId         String?      @db.ObjectId
  requesterName      String
  requesterEmail     String
  organizationalUnit String
  room               String
  phone              String
  subject            String
  body               String
  computerIp         String?
  status             TicketStatus @default(OPEN)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  group       TicketGroup  @relation(fields: [groupId], references: [id])
  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  attachments Attachment[]
  comments    Comment[]
}

model Attachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId     String   @db.ObjectId
  originalName String
  filename     String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

/** Pracownicy / zgłaszający — auto-dodawani przy tworzeniu zgłoszenia */
model Worker {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Komentarze do zgłoszenia — autor identyfikowany mailem */
model Comment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId    String   @db.ObjectId
  authorEmail String
  authorName  String?
  body        String
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}
