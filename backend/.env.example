# MongoDB connection string (required)
# DATABASE_URL="mongodb://user:password@host:27017/intranet?authSource=admin"
DATABASE_URL=

PORT=3000
UPLOADS_DIR=./uploads

# Publiczny URL frontendu (linki w mailach)
APP_URL=http://localhost:4200

# SMTP — bez SMTP_HOST maile są pomijane (log w konsoli)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Helpdesk <helpdesk@szpital.local>"
