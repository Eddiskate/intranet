# ── Lokalne (dev) — wzorzec ───────────────────────────────────
# cp .env.example .env

NODE_ENV=development
PORT=3000
DATABASE_URL=mongodb://127.0.0.1:27017/intranet
# MONGO_URL=
UPLOADS_DIR=./uploads
JWT_SECRET=dev-intranet-helpdesk-secret

APP_URL=http://localhost:4200
# CORS_ORIGIN=http://localhost:4200

# ── HTTP Basic Auth (opcjonalnie; na EasyPanel ustaw te same klucze) ──
# Bez tych zmiennych auth HTTP jest wyłączony.
# HTAUTH_USER=intranet
# HTAUTH_PASS=sekretne-haslo

# ── SMTP / poczta ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Helpdesk <helpdesk@szpital.local>"
