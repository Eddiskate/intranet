# ── Produkcja — wzorzec ───────────────────────────────────────
# cp .env.production.example .env.production
# albo ustaw te same klucze w EasyPanel → Environment.

NODE_ENV=production
PORT=3000
DATABASE_URL=
# MONGO_URL=

UPLOADS_DIR=/data/uploads
JWT_SECRET=

APP_URL=https://intranet.twoja-domena.pl
CORS_ORIGIN=https://intranet.twoja-domena.pl
SEED_ON_START=false

# ── SMTP / poczta ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Helpdesk <helpdesk@szpital.local>"
